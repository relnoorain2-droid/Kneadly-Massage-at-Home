# Alternative to the GitHub Actions workflow, for anyone who prefers fastlane
# or wants to run the upload from a borrowed Mac.
#
#   bundle exec fastlane beta
#
# Reads the same four values, from the environment:
#   APPLE_TEAM_ID, APP_STORE_CONNECT_KEY_ID,
#   APP_STORE_CONNECT_ISSUER_ID, APP_STORE_CONNECT_PRIVATE_KEY

default_platform(:ios)

platform :ios do
  desc "Generate the Xcode project from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Download the photography set"
  lane :assets do
    sh("cd .. && bash Scripts/fetch_assets.sh")
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do |options|
    build = options[:build] || Time.now.strftime("%y%m%d%H%M")
    sh("cd .. && bash Scripts/fetch_assets.sh || true")
    sh("cd .. && bash Scripts/bump_build.sh #{build}")
    generate

    key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      in_house: false
    )

    build_app(
      project: "Kneadly.xcodeproj",
      scheme: "Kneadly",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      changelog: options[:notes] || "New build."
    )
  end

  desc "Compile and run the unit tests"
  lane :test do
    generate
    run_tests(
      project: "Kneadly.xcodeproj",
      scheme: "Kneadly",
      devices: ["iPhone 16"]
    )
  end
end
